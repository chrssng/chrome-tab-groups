{
  "format": "tab-groups-by-url",
  "version": 1,
  "settings": {
    "enabled": true,
    "ungroupOnLeave": true,
    "openInListOrder": true
  },
  "categories": [
    { "name": "Work", "openCollapsed": false },
    { "name": "Reading", "openCollapsed": true },
    { "name": "Default", "openCollapsed": false }
  ],
  "groups": [
    {
      "name": "Issues & PRs",
      "category": "Work",
      "color": "red",
      "patterns": [
        "# wildcards – must stay above “GitHub”, otherwise that group wins",
        "github.com/*/issues",
        "github.com/*/pulls"
      ],
      "openUrls": [
        "https://github.com/microsoft/vscode/issues",
        "https://github.com/nodejs/node/pulls"
      ],
      "enabled": true
    },
    {
      "name": "GitHub",
      "category": "Work",
      "color": "grey",
      "patterns": [
        "github.com"
      ],
      "openUrls": [],
      "enabled": true
    },
    {
      "name": "Docs",
      "category": "Work",
      "color": "cyan",
      "patterns": [
        "# path prefixes",
        "developer.chrome.com/docs/extensions",
        "developer.mozilla.org/*/docs",
        "nodejs.org/docs"
      ],
      "openUrls": [
        "https://developer.chrome.com/docs/extensions/reference/api/tabGroups",
        "https://developer.mozilla.org/en-US/docs/Web/JavaScript",
        "nodejs.org/docs/latest/api/"
      ],
      "enabled": true
    },
    {
      "name": "Local dev",
      "category": "Work",
      "color": "green",
      "patterns": [
        "localhost:3000",
        "localhost:5173",
        "localhost/dashboard",
        "localhost/phpmyadmin",
        "127.0.0.1"
      ],
      "openUrls": [
        "localhost/dashboard",
        "localhost/phpmyadmin"
      ],
      "enabled": true,
      "openCollapsed": true
    },
    {
      "name": "Docs",
      "category": "Reading",
      "showCategory": true,
      "color": "blue",
      "patterns": [
        "# same name as in “Work” – the tab title shows the category: “Reading · Docs”",
        "docs.google.com"
      ],
      "openUrls": [
        "https://docs.google.com/document/u/0/"
      ],
      "enabled": true
    },
    {
      "name": "Wikipedia",
      "category": "Reading",
      "color": "purple",
      "patterns": [
        "# with scheme – http:// does not match",
        "https://*.wikipedia.org/wiki"
      ],
      "openUrls": [
        "https://en.wikipedia.org/wiki/Tab_(interface)",
        "https://de.wikipedia.org/wiki/Google_Chrome"
      ],
      "enabled": true
    },
    {
      "name": "PDFs",
      "category": "Reading",
      "color": "orange",
      "patterns": [
        "/\\.pdf([?#]|$)/i"
      ],
      "openUrls": [
        "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
      ],
      "enabled": true
    },
    {
      "name": "News",
      "category": "Reading",
      "color": "pink",
      "patterns": [],
      "openUrls": [
        "# paused starter set: no patterns, only opened on demand",
        "https://news.ycombinator.com",
        "https://www.heise.de",
        "https://www.tagesschau.de"
      ],
      "enabled": false
    },
    {
      "name": "Google",
      "category": "Default",
      "color": "blue",
      "patterns": [
        "# catch-all, so its section is at the bottom: the more specific groups above win",
        "google.com",
        "!mail.google.com",
        "!google.com/maps"
      ],
      "openUrls": [],
      "enabled": true
    },
    {
      "name": "Mail",
      "category": "Default",
      "color": "yellow",
      "patterns": [
        "mail.google.com",
        "outlook.live.com"
      ],
      "openUrls": [],
      "enabled": true
    }
  ]
}
