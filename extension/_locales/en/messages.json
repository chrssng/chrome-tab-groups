  "syntaxOpen": {
    "message": "Concrete URLs that “Open group” loads as tabs, e.g. <code>https://github.com/my-company/webshop/pulls</code>. Without a scheme, <code>https://</code> is added (<code>http://</code> for <code>localhost</code>, IP addresses and URLs with a port). If the field is empty, the URL patterns that are concrete URLs are opened. Pages that are already open in the group are not opened twice; an empty “New Tab” is used for the first page."
  },
